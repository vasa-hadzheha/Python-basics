# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- IDE ---
.idea/
.vscode/

# --- Office temp / lock files ---
~$*

# --- Course scratch output ---
# Files produced by running the lessons. Delete them freely and re-run.
out/
*.out.txt
data/*.db

# --- Obsidian ---
# app.json and appearance.json ARE committed: they make the vault render the
# same way GitHub does (see OBSIDIAN.md). Everything else is per-machine
# state that would only cause conflicts.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/graph.json
.obsidian/hotkeys.json
.obsidian/core-plugins*.json
.obsidian/community-plugins.json
.obsidian/plugins/
.obsidian/themes/
.obsidian/snippets/
.trash/
